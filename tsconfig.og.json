{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2022.Intl", "DOM"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "lib/seo.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".generated"]
}
